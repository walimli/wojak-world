{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wojak World",
  "version": "0.1.0",
  "identifier": "com.william.wojakworld",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wojak World",
        "width": 1100,
        "height": 740,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 ws://127.0.0.1:1420",
        "img-src": "'self' http://wojak.localhost data: blob:",
        "style-src": "'unsafe-inline' 'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
